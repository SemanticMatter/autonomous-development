{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex attempt accounting ledger event",
  "description": "One line of <accounting-home>/v1/codex-attempts.jsonl. Strict allowlist: no prompt/output/stderr text, environment, absolute paths, hostnames or credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "event_id", "event_type", "attempt_id", "ledger_id", "recorded_at"],
  "properties": {
    "format": {"const": "claude-autonomous.codex-attempt-event/1"},
    "event_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "event_type": {"enum": ["attempt.reserved", "attempt.settled"]},
    "attempt_id": {"$ref": "#/$defs/attempt_id"},
    "ledger_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "recorded_at": {"$ref": "#/$defs/timestamp"},
    "reservation": {"$ref": "#/$defs/reservation"},
    "settlement": {"$ref": "#/$defs/settlement"}
  },
  "oneOf": [
    {
      "properties": {"event_type": {"const": "attempt.reserved"}},
      "required": ["reservation"],
      "not": {"required": ["settlement"]}
    },
    {
      "properties": {"event_type": {"const": "attempt.settled"}},
      "required": ["settlement"],
      "not": {"required": ["reservation"]}
    }
  ],
  "$defs": {
    "attempt_id": {"type": "string", "pattern": "^cxa-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{16}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\+00:00|Z)$"},
    "safe_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
    "ref_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,119}$"},
    "short_text": {"type": ["string", "null"], "maxLength": 200, "pattern": "^[^\\u0000-\\u001f]*$"},
    "counter": {"type": ["integer", "null"]},
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retry_of", "slot_attempt", "tool", "phase", "slot", "delta_review",
        "timeout_seconds", "launcher", "workflow", "requested", "engine",
        "python", "refs", "prompt_characters"
      ],
      "properties": {
        "retry_of": {"oneOf": [{"$ref": "#/$defs/attempt_id"}, {"type": "null"}]},
        "slot_attempt": {"type": "integer", "minimum": 1},
        "tool": {"const": "codex-exec"},
        "phase": {"enum": ["enhance", "plan", "review", "adversarial"]},
        "slot": {"type": "string", "pattern": "^(enhance|plan|review-[0-9]{2,}|adversarial-[0-9]{2,})$"},
        "delta_review": {"type": "boolean"},
        "timeout_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "launcher": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pid", "boot_id", "host_label"],
          "properties": {
            "pid": {"type": "integer", "minimum": 1},
            "boot_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
            "host_label": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"}
          }
        },
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repo_id", "run_id", "workflow_kind", "state_home_overridden",
            "review_contract_generation"
          ],
          "properties": {
            "repo_id": {"$ref": "#/$defs/safe_id"},
            "run_id": {"$ref": "#/$defs/safe_id"},
            "workflow_kind": {"enum": ["feature", "existing_pr_review", "unknown"]},
            "state_home_overridden": {"type": "boolean"},
            "review_contract_generation": {"type": ["integer", "null"], "minimum": 1}
          }
        },
        "requested": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "reasoning_effort", "verbosity", "profile_overridden"],
          "properties": {
            "model": {"$ref": "#/$defs/short_text"},
            "reasoning_effort": {"$ref": "#/$defs/short_text"},
            "verbosity": {"$ref": "#/$defs/short_text"},
            "profile_overridden": {"type": "boolean"}
          }
        },
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "code_digest", "root_kind"],
          "properties": {
            "version": {"$ref": "#/$defs/short_text"},
            "code_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "root_kind": {"enum": ["git-worktree", "plain"]}
          }
        },
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": ["implementation", "version"],
          "properties": {
            "implementation": {"type": "string", "maxLength": 40},
            "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
          }
        },
        "refs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["work_package", "pr", "track", "round", "context"],
          "properties": {
            "work_package": {"$ref": "#/$defs/ref_id"},
            "pr": {
              "oneOf": [
                {"type": "null"},
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["number"],
                  "properties": {"number": {"type": "integer", "minimum": 1}}
                }
              ]
            },
            "track": {"$ref": "#/$defs/ref_id"},
            "round": {"type": ["integer", "null"], "minimum": 1},
            "context": {"$ref": "#/$defs/ref_id"}
          }
        },
        "prompt_characters": {"type": "integer", "minimum": 0}
      }
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["settled_by", "execution", "result", "usage", "observed", "output_characters"],
      "properties": {
        "settled_by": {"enum": ["engine", "operator"]},
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "exit_code", "duration_seconds", "stdout_truncated"],
          "properties": {
            "status": {"enum": ["exited", "timed_out", "interrupted", "launch_failed", "unknown"]},
            "exit_code": {"type": ["integer", "null"]},
            "duration_seconds": {"type": ["number", "null"], "minimum": 0},
            "stdout_truncated": {"type": "boolean"}
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": {"enum": ["published", "rejected", "not_evaluated", "unknown"]},
            "reason": {
              "enum": [
                null, "nonzero_exit", "timeout", "missing_output", "oversize_output",
                "invalid_json", "not_object", "schema_invalid", "semantic_invalid",
                "run_inactive", "target_drift", "contract_drift", "round_mode_mismatch",
                "review_budget_exhausted", "interrupted", "internal_error",
                "launch_failed", "operator_abandoned"
              ]
            }
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "source", "counters", "flags", "invalid_reasons"],
          "properties": {
            "status": {"enum": ["complete", "partial", "unavailable", "invalid", "not_applicable"]},
            "source": {"enum": ["codex-exec-json-stdout", null]},
            "counters": {
              "type": "object",
              "additionalProperties": false,
              "required": ["input_tokens", "cached_input_tokens", "output_tokens", "reasoning_output_tokens"],
              "properties": {
                "input_tokens": {"$ref": "#/$defs/counter"},
                "cached_input_tokens": {"$ref": "#/$defs/counter"},
                "output_tokens": {"$ref": "#/$defs/counter"},
                "reasoning_output_tokens": {"$ref": "#/$defs/counter"}
              }
            },
            "flags": {
              "type": "array",
              "uniqueItems": true,
              "items": {"enum": ["multiple_usage_events", "stdout_truncated", "missing_counters"]}
            },
            "invalid_reasons": {
              "type": "array",
              "uniqueItems": true,
              "items": {"enum": ["non_integer", "negative", "cached_exceeds_input", "reasoning_exceeds_output", "usage_not_object"]}
            }
          }
        },
        "observed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "thread_id"],
          "properties": {
            "model": {"$ref": "#/$defs/short_text"},
            "thread_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9-]{1,80}$"}
          }
        },
        "output_characters": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
